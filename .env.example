# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=retail_agent_db

# ─── Ollama ─────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_EMBED_MODEL=nomic-embed-text   # or use sentence-transformers fallback

# ─── Embedding ───────────────────────────────────────────────────────────────
EMBED_BACKEND=ollama                  # "ollama" | "sentence_transformers"
EMBED_ST_MODEL=all-MiniLM-L6-v2      # used when EMBED_BACKEND=sentence_transformers
EMBED_DIMENSION=768

# ─── Agent ───────────────────────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
MEMORY_WINDOW=10                      # last N messages to inject as context
VECTOR_TOP_K=5

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
